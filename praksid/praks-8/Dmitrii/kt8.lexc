  :%{NA%}%>u sg_gen_jt ; 
  +Sg+Part:%>ut gi_lopp ;            
  +Pl:%>ute semkäänded ;
  +Pl+Part:%>uid gi_lopp ;


LEXICON Omadussonad

LEXICON tüüp_kena
  +Sg+Nom:%>a gi_lopp ;
  :%{NA%}%>a sg_gen_jt ;
  +Sg+Part:%>a gi_lopp ;
  +Pl:%>ade semkäänded ;
  +Pl+Part:%>asid gi_lopp ;


LEXICON tüüp_armas
  +Sg+Nom: gi_lopp ;
  :%{NA%}%>sa sg_gen_jt ; 
  +Sg+Part:%>sat gi_lopp ;            
  +Pl:%>sate semkäänded ;
  +Pl+Part:%>sasid gi_lopp ;
	

LEXICON sg_gen_jt
  +Sg+Gen: gi_lopp ;
  +Sg: semkäänded ;
  +Pl+Nom:%>d gi_lopp ;

LEXICON gi_lopp
  +Rohk:%>GKi # ;
  : # ;

LEXICON semkäänded
  +Gen: gi_lopp ;
  +Ill:%>sse gi_lopp ;
  +In:%>s gi_lopp ;
  +El:%>st gi_lopp ;
  +All:%>le gi_lopp ;
  +Ad:%>l gi_lopp ;
  +Abl:%>lt gi_lopp ;
  +Tr:%>ks gi_lopp ;
  +Term:%>ni gi_lopp ;
  +Es:%>na gi_lopp ;
  +Abes:%>ta gi_lopp ;
  +Kom:%>ga gi_lopp ;