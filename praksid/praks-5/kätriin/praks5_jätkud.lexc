

LEXICON tüüp_sada
    +Sg+Nom: # ;
            :%{NA%}%> gen_jt ; 
    +Sg+Par:%> # ;         
      +Pl+Nom:%>d # ;     
      +Pl+Gen:%>de gen_jt ;
    +Pl+Par:%>sid # ;

 LEXICON tüüp_kaks
    +Sg+Nom: # ;
            :%{NA%}%>e gen_jt ; 
     +Sg+Par:%>t # ;              
      +Pl:%{NA%}%>ed gen_jt ;
  +Pl+Par:%>esid # ;

  LEXICON tüüp_kümmend
    +Sg+Nom: # ;
            :%{NA%}%>e gen_jt ; ! kümne
     +Sg+Par:%> # ;              
      +Pl:%{NA%}%>ed gen_jt ;
  +Pl+Par:%{NA%}%>id # ; 

!LEXICON sg_gen_jt
!            +Sg:%> gen_jt ;
!        +Pl+Nom:%>d # ;
! +Der/m+A+Comp:%>m tüüp_kaup ;  ! <-- tuletus
!   +Der/lt+Adv:%>lt # ;          ! <-- tuletus
  
LEXICON gen_jt
       +Gen: # ;
       +Ill:sse # ;	
       +Ine:s # ;	
       +Ela:st # ;	
       +All:le # ;	
       +Ade:l # ;	
       +Abl:lt # ;	
       +Tra:ks # ;	
       +Trm:ni # ;	
       +Ess:na # ;	
       +Abe:ta # ;	
       +Com:ga # ;	

