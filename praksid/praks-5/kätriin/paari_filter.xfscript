#
define Number ["+Sg" | "+Pl" ];
define Nom ["+Nom" ];
define Cases ["+Gen" | "+Par" | "+Ill" | "+Ine" | "+Ela" | "+All" | "+Ade" | "+Abl" | "+Tra" | "+Ter" | "+Ess" | "+Abe" | "+Kom"]; 
define Case [ Nom | Cases ] ;

# mõlemad sõnad on kas ainsuses või mitmuses, mitte segamini
# define SameNumber $[["+Sg" \Number* "+Sg"] | ["+Pl" \Number* "+Pl"]] ;
define NumberRule $[["+Sg" \Number* "+Sg"] | ["+Sg" \Number* "+Pl"]] ;

# mõlemad sõnad on samas käändes
define SameCase10 ["+Nom" \Case* "+Nom"] ; 

# esimene on omastavas, teised teistes käänetes
# kahekümnega
define GenCases ["+Gen" \Case* Cases] ; 
#define GenCases ["+Gen" \Case* "+Ill"] ; 

# sobivad käändepaarid on seega
define PairedCase [ \Case* [SameCase10 | GenCases] \Case* ];

# sõnade vahel on:
define Middle [Number Case] ;

# paarissõnad on:
define Pairs [ [{kaks} Middle {kümmend}] |
               [{kaks} Middle {sada}] |
               [{kuus} Middle {kümmend}] |
               [{kuus} Middle {sada}] ] ;

#define WordPairs [?* Pairs ?*] ;
# paarissõnad tegelikult on natuke rohkem kui enne sai defineeritud
define WordPairs [ Pairs ?*] ;

# eemalda esimese sõna arv ja number, et paarissõna lemma näeks ilusam välja
define CleanUp [[..] <- Case   || Number _ \[Number | Case]* Number Case ,, 
                [..] <- Number ||   _  Case \[Number | Case]* Number Case ] ;

regex [ CleanUp .o. [WordPairs & NumberRule & PairedCase] ] ;
# & PairedCase

