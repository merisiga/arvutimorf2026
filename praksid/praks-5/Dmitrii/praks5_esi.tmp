

Multichar_Symbols

+Sg
+Pl
+Nom    ! nimetav
+Gen    ! omastav
+Par    ! osastav
+Ill    ! sisseütlev
+Ine    ! seesütlev
+Ela    ! seestütlev
+All    ! alaleütlev
+Ade    ! alalütlev
+Abl    ! alaltütlev
+Tra    ! saav
+Ter    ! rajav
+Ess    ! olev
+Abe    ! ilmaütlev
+Kom    ! kaasaütlev


%>                ! morfeemi piir



LEXICON Root

kaks:kaks kaks_tugev ;        ! kaks -> kahe / kahte
kaks:kah kaks_nõrk ; 	
paar:paar tüüp_riik ;		! paar -> paari
 


LEXICON kaks_tugev
	+Sg+Nom: # ;
	
LEXICON kaks_nõrk
	+Sg+Gen:e    # ;                ! kahe
	+Sg+Par:t   # ;                ! kaht
	+Sg+Ill:te   # ;                ! kahte
	+Sg+Ine:es   # ;                ! kahes
	+Sg+Ela:est  # ;
	+Sg+All:ele  # ;
	+Sg+Ade:el   # ;
	+Sg+Abl:elt  # ;
	+Sg+Tra:eks  # ;
	+Sg+Ter:eni  # ;
	+Sg+Ess:ena  # ;
	+Sg+Abe:eta  # ;
	+Sg+Com:ega  # ;
	
LEXICON tüüp_riik
	+Sg+Nom: # ;
	:i 2C ; 
	
	
LEXICON 2C
    : sg_gen_jt ; 
    +Sg+Par: # ;
    +Pl+Gen:%>de # ;
    +Pl:%>de genjt ;
    +Pl+Par:%>sid # ;
    
LEXICON tüüp_knd
    +Sg+Nom:mend # ;
    :ne sg_gen_jt ; 
    +Sg+Par:met # ;
    +Pl+Gen:ne%>te # ;
    +Pl:ne%>te genjt ;
    +Pl+Par:ne%>id # ;
    
LEXICON tüüp_sada
	+Sg+Nom: # ;
	:%{NA%} sg_gen_jt ;
	+Sg+Par: # ;
	+Pl+Gen:%>de # ;
	+Pl+Par:%>de genjt ;
	+Pl+Par:%>sid # ;
    

LEXICON sg_gen_jt
        +Sg+Gen: # ;
        +Sg: genjt ; 
        +Pl+Nom:%>d # ;
  
LEXICON genjt

    +Ill:%>sse # ;
    +Ine:%>s # ;
    +Ela:%>st # ;
    +All:%>le # ;
    +Ade:%>l # ;
    +Abl:%>lt # ;
    +Tra:%>ks # ;
    +Ter:%>ni # ;
    +Ess:%>na # ;
    +Abe:%>ta # ;
    +Kom:%>ga # ;	

