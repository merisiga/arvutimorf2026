

Multichar_Symbols

+Sg
+Pl
+Nom    ! nimetav
+Gen    ! omastav
+Par    ! osastav
+Ill    ! sisseütlev
+Ine    ! seesütlev
+Ela    ! seestütlev
+All    ! alaleütlev
+Ade    ! alalütlev
+Abl    ! alaltütlev
+Tra    ! saav
+Ter    ! rajav
+Ess    ! olev
+Abe    ! ilmaütlev
+Kom    ! kaasaütlev


%>                ! morfeemi piir


! paarissõna tagumine osa


LEXICON Root

kümmend+N:küm tüüp_knd ;
sada+N:sada tüüp_sada ; 


LEXICON tüüp_kolm
    +Sg+Nom: # ;
    :e 2C; 

LEXICON tüüp_paar
    +Sg+Nom: # ;
    :i 2C ;

LEXICON 2C
    : sg_gen_jt ; 
    +Sg+Par: # ;
    +Pl+Gen:%>de # ;
    +Pl:%>de semkäänded ;
    +Pl+Par:%>sid # ;

LEXICON tüüp_sada
    +Sg+Nom: # ;
    :%{NA%} sg_gen_jt ; 
    +Sg+Par: # ;
    +Pl+Gen:%>de # ;
    +Pl:%>de semkäänded ;
    +Pl+Par:%>sid # ;

LEXICON tüüp_knd
    +Sg+Nom:mend # ;
    :ne sg_gen_jt ; 
    +Sg+Par:met # ;
    +Pl+Gen:ne%>te # ;
    +Pl:ne%>te semkäänded ;
    +Pl+Par:ne%>id # ;


LEXICON sg_gen_jt
    +Sg+Gen: # ;
    +Sg: semkäänded ;
    +Pl+Nom:%>d # ;

LEXICON semkäänded

    +Ill:%>sse # ;
    +Ine:%>s # ;
    +Ela:%>st # ;
    +All:%>le # ;
    +Ade:%>l # ;
    +Abl:%>lt # ;
    +Tra:%>ks # ;
    +Ter:%>ni # ;
    +Ess:%>na # ;
    +Abe:%>ta # ;
    +Kom:%>ga # ;
