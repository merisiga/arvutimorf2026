

%{NA%}		! Nõrk aste
K1          ! k või h

LEXICON Root

kaks:kaK1s tüüp_põu ;        ! kaks -> kahe / kahte
paar:paar tüüp_riik ;		! paar -> paari
 


LEXICON tüüp_põu
	+Sg+Nom: # ;
		:%{NA%}e gen_jt ;        ! kaks -> kahe 
	+Sg+Par:%{NA%}te # ;            ! kaks -> kahte         
	+Pl:%{NA%}te sem_k ;       
	+Pl+Par:%{NA%}t # ;
	
	
LEXICON tüüp_riik
	+Sg+Nom: # ;
		:i gen_jt ;        ! paari 
	+Sg+Par:i # ;                 
	+Pl:ide sem_k ;       
	+Pl+Par:e # ;			!paarekümne?

