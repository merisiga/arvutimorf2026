LEXICON tüüp_ema
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%} sg_gen_jt ;
  +Sg+Par:%> GI_OPTIONAL ;
  +Pl+Gen:%>de GI_OPTIONAL ;
      +Pl:%>de semkäänded ;
  +Pl+Par:%>sid GI_OPTIONAL ;

! Ann: nagu jaan (riik-tüüp): Ann - Anni - Anni - Annid - Annide - Annisid
LEXICON tüüp_riik
  +Sg+Nom: GI_OPTIONAL ;
         :i sg_gen_jt ;
  +Sg+Par:i GI_OPTIONAL ;
  +Pl+Gen:i%>de GI_OPTIONAL ;
      +Pl:i%>de semkäänded ;
  +Pl+Par:i%>sid GI_OPTIONAL ;

! Tartu: Sg+Par -t, Pl+Gen -te (nagu 2C)
LEXICON tüüp_u
  +Sg+Nom: GI_OPTIONAL ;
         : 2C ;

! Salutee: nagu idee (ideed, ideede, ideid)
LEXICON tüüp_idee
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%} sg_gen_jt ;
  +Sg+Par:%>d GI_OPTIONAL ;
  +Pl+Gen:%>de GI_OPTIONAL ;
      +Pl:%>de semkäänded ;
  +Pl+Par:%>id GI_OPTIONAL ;

LEXICON tüüp_vidin
  +Sg+Nom: GI_OPTIONAL ;
         :a 2C ;

LEXICON tüüp_redel
  +Sg+Nom: GI_OPTIONAL ;
         :i 2C ;

LEXICON 2C
         : sg_gen_jt ;
  +Sg+Par:%>t GI_OPTIONAL ;
  +Pl+Gen:%>te GI_OPTIONAL ;
      +Pl:%>te semkäänded ;
  +Pl+Par:%>id GI_OPTIONAL ;

! nõrga astme vormid: ainsuse omastav, ainsuse käänded, mitmuse nimetav
LEXICON sg_gen_jt
  +Sg+Gen: GI_OPTIONAL ;
  +Sg: semkäänded ;
  +Pl+Nom:%>d GI_OPTIONAL ;
  ! tuletus (sobimatud kombinatsioonid filtreerib välja blokeeri_tuletus.xfscript)
  +Der/m+A+Comp:%>m tüüp_vidin ;       ! kenam
  +Der/im+A+Super:%>im tüüp_vidin ;    ! kenaim
  +Der/lt+Adv:%>lt GI_OPTIONAL ;       ! kenalt, kenamalt (vidin-tüübi :a kaudu)
  +Der/lik+A:%>li tüüp_lik ;           ! kolilik

LEXICON semkäänded
       +Ill:sse GI_OPTIONAL ;
       +Ine:s GI_OPTIONAL ;
       +Ela:st GI_OPTIONAL ;
       +All:le GI_OPTIONAL ;
       +Ade:l GI_OPTIONAL ;
       +Abl:lt GI_OPTIONAL ;
       +Tra:ks GI_OPTIONAL ;
       +Trm:ni GI_OPTIONAL ;
       +Ess:na GI_OPTIONAL ;
       +Abe:ta GI_OPTIONAL ;
       +Com:ga GI_OPTIONAL ;

! Rõhupartikkel: analüüsi tasemel +Gi, lexc-i alumisel tasemel gi.
! Twolc muudab gi -> ki helitu hääliku järel.
LEXICON GI_OPTIONAL
+Gi:gi # ;
# ;

! ----- kk pp tt (nõrgas astmes {NA} järel tüvevokaal)
LEXICON tüüp_kk
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%}u sg_gen_jt ;
  +Sg+Par:%>u GI_OPTIONAL ;
  +Pl+Gen:u%>de GI_OPTIONAL ;
      +Pl:u%>de semkäänded ;
  +Pl+Par:u%>sid GI_OPTIONAL ;

LEXICON tüüp_pp
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%}i sg_gen_jt ;
  +Sg+Par:%>i GI_OPTIONAL ;
  +Pl+Gen:i%>de GI_OPTIONAL ;
      +Pl:i%>de semkäänded ;
  +Pl+Par:i%>sid GI_OPTIONAL ;

LEXICON tüüp_tt
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%}i sg_gen_jt ;
  +Sg+Par:%>i GI_OPTIONAL ;
  +Pl+Gen:i%>de GI_OPTIONAL ;
      +Pl:i%>de semkäänded ;
  +Pl+Par:i%>sid GI_OPTIONAL ;

! ----- k p t -> g b d
LEXICON tüüp_k2
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%}i sg_gen_jt ;
  +Sg+Par:%>i GI_OPTIONAL ;
  +Pl+Gen:i%>de GI_OPTIONAL ;
      +Pl:i%>de semkäänded ;
  +Pl+Par:i%>sid GI_OPTIONAL ;

LEXICON tüüp_p2
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%}a sg_gen_jt ;
  +Sg+Par:%>a GI_OPTIONAL ;
  +Pl+Gen:a%>de GI_OPTIONAL ;
      +Pl:a%>de semkäänded ;
  +Pl+Par:a%>sid GI_OPTIONAL ;

LEXICON tüüp_t2
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%}u sg_gen_jt ;
  +Sg+Par:%>u GI_OPTIONAL ;
  +Pl+Gen:u%>de GI_OPTIONAL ;
      +Pl:u%>de semkäänded ;
  +Pl+Par:u%>sid GI_OPTIONAL ;

! ----- g b d kaob (tüvevokaal on sõna enda sees; osastav = tugev tüvi)
LEXICON tüüp_kpt
  +Sg+Nom: GI_OPTIONAL ;
         :%{NA%} sg_gen_jt ;
  +Sg+Par:%> GI_OPTIONAL ;
  +Pl+Gen:%>de GI_OPTIONAL ;
      +Pl:%>de semkäänded ;
  +Pl+Par:%>sid GI_OPTIONAL ;

! ----- lik-liide: käändub nagu lukk (luku, lukku), aga ainsuse nimetavas on üks k
! lik - liku - likku - likud - likkude
LEXICON tüüp_lik
  +Sg+Nom:k GI_OPTIONAL ;
         :K1k%{NA%}u sg_gen_jt ;
  +Sg+Par:K1k%>u GI_OPTIONAL ;
  +Pl+Gen:K1ku%>de GI_OPTIONAL ;
      +Pl:K1ku%>de semkäänded ;
  +Pl+Par:K1ku%>sid GI_OPTIONAL ;
