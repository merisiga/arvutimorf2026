! Arvsõnapaarid, mille mõlemad pooled käänduvad (kakssada, kakskümmend, paarsada, paarkümmend).
! Analüüs enne filtrit: esimene pool + teine pool, nt kaks+Sg+Genkümmend+Num+Sg+Com.
! Filter jätab alles ainult õiged käändekombinatsioonid ja CleanUp eemaldab
! esimese poole arvu ja käände, nii et lõpuks on analüüs kakskümmend+Num+Sg+Com.

define Number ["+Sg" | "+Pl"] ;
define CaseGram ["+Nom" | "+Gen" | "+Par"] ;
define CaseOblique ["+Ill" | "+Ine" | "+Ela" | "+All" | "+Ade" | "+Abl" | "+Tra" | "+Trm" | "+Ess" | "+Abe" | "+Com"] ;
define Case [CaseGram | CaseOblique] ;

! Nom-Nom (kakssada), Gen-Gen (kahesaja), Par-Par (kahtsadat)
! ja esimene pool omastavas, teine pool kohakäändes (kahesajasse)
define PairedCase [ ["+Sg" "+Nom" \[Number | Case]* "+Sg" "+Nom"] |
                    ["+Sg" "+Gen" \[Number | Case]* "+Sg" "+Gen"] |
                    ["+Sg" "+Par" \[Number | Case]* "+Sg" "+Par"] |
                    ["+Sg" "+Gen" \[Number | Case]* "+Sg" CaseOblique] ] ;
define GoodCase [ \[Number | Case]* PairedCase \[Number | Case]* ] ;

! sõnade vahel on esimese poole arv ja kääne
define Middle [Number Case] ;

define Esi [{kaks} | {paar}] ;
define Tagu [{sada} | {kümmend}] ;
define Pairs [Esi Middle Tagu] ;
define WordPairs [?* Pairs ?*] ;

! esimese poole arv ja kääne jäetakse analüüsist välja
define CleanUp [[..] <- Case || Number _ (?) \[Number | Case]* Number Case ,,
                [..] <- Number || _ Case (?) \[Number | Case]* Number Case ] ;

read regex [ CleanUp .o. [WordPairs & GoodCase] ] ;
