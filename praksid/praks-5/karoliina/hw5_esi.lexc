
LEXICON Root

üks:üK3S1 tüüp_põu ;
kaks:kaK3S1 tüüp_põu ;
kolm:kolm tüüp_kolm ;
neli:nelI1 tüüp_padi ;
viis:viiS1 tüüp_uus ;
kuus:kuuS1 tüüp_uus ;
seitse:seitsM1e tüüp_kümmend ;
kaheksa:kaheksa tüüp_ohutu ;
üheksa:üheksa tüüp_ohutu ;

LEXICON tüüp_põu
    +Sg+Nom: # ;
           :%{NA%}e gen_jt ;   ! k a k s +Gen-> k a h 0 +e
    +Sg+Par:%{NA%}te # ;			! ma ütleks pigem kahte kui kaht
        +Pl:%{NA%}te sem_käänded ;
    +Pl+Par:%{NA%}t # ;
    
LEXICON tüüp_padi
    +Sg+Nom: # ;
           :%{NA%}a gen_jt ;            ! tegelt TA, mugavuse mõttes hetkel NA
    +Sg+Par:%{NA%}a # ;		
        +Pl:%{NA%}ade sem_käänded ;
    +Pl+Par:%>u # ;
    
LEXICON tüüp_kolm
    +Sg+Nom: # ;
           :e gen_jt ;
    +Sg+Par:%>e # ;
        +Pl:%>de sem_käänded ;
    +Pl+Par:%>i # ;

LEXICON tüüp_uus
    +Sg+Nom: # ;
           :%{NA%}e gen_jt ;
    +Sg+Par:%{NA%}te # ;		! ma ütleks pigem viite kui viit
        +Pl:%{NA%}te sem_käänded ;
    +Pl+Par:%>i # ;
    
LEXICON tüüp_ohutu
    +Sg+Nom: # ;
           : gen_jt ;
    +Sg+Par:%>t # ;
        +Pl:%>te sem_käänded ;
    +Pl+Par:%>id # ;
    
