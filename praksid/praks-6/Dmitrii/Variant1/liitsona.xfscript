! 1. lihtsõnamuundur: lexc + twolc, kõik käänded, ka -gi
define Lihtsonamuundur @"lihtsonamuundur.hfst" ;

! 2. piiratum muundur: ainult rajad, mis sobivad liitsõna mitte-viimaseks osaks
define Sonaliik  [ "+N" | "+A" ] ;
define EsiKaane  [ "+Sg" [ "+Nom" | "+Gen" ] ] ;

! rada peab SELLEGA LÕPPEMA, seega +Rohk (-gi) välistub ise
define EsiRada   [ ?* Sonaliik EsiKaane ] ;

define PiiratumMuundur [ EsiRada .o. Lihtsonamuundur ] ;

! 3. liitsõnamuundur: null või rohkem esiosa + lihtsõna
define KoikSonad [ PiiratumMuundur^{0,2} Lihtsonamuundur ] ;

read regex KoikSonad ;
save stack liitsonaxfst.hfst
quit