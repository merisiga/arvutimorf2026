# blokeeri mõned rajad

# defineeri pahad rajad

define PahaTuletus [~[?* "+A" ?*] "+Der/m" ?*] | [~[?* "+A" ?*] "+Der/lt" ?*] | [~[?* "+A" ?*] "+Der/im" ?*] | [~[?* "+N" ?*] "+Der/lik" ?*] | [?* "+Comp" ?* "+Superl" ?*] |  [?* "+Superl" ?* "+Comp" ?*];

define PahadSonad [{pikk} "+A" ["+Der/m" | "+Der/im"] ?*] | [{kena} "+A" ?* "+Der/im" ?*];

# sama tuletust mitu korda ei luba

define PahaKordus [["+Der/m"] ?* ["+Der/m"]] | [["+Der/lt"] ?* ["+Der/lt"]] | [["+Der/im"] ?* ["+Der/im"]] | [["+Der/lik"] ?* ["+Der/lik"]];

define LiitSonaReeglid [[?* "+N" ?* "+N" ?* "+Sg" "+Nom" ?* ]]

# head rajad on need, mis pole ei need ega teised pahad rajad

define HeadRajad [~[PahaTuletus] & [~[?* PahaKordus ?*]] & [~[PahadSonad ?*]] & [ LiitSonaReeglid ]];

regex HeadRajad ;
