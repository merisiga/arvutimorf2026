;

Sets

Vowel = A E I O U Õ Ä Ö Ü Y
        a e i o u õ ä ö ü y ;

Consonant = b c d f g h j k l m n p q r s š z ž t v w x
            B C D F G H J K L M N P Q R S Š Z Ž T V W X ;
            
Voiceless = g b d k p t s š h f
	    G B D K P T S Š H F ;


Definitions

Rules 

! ----- kaashäälikud

"Nõrgas astmes vahel s kaob"
! lexical: k ä S1 i {NA}         
! surface: k ä  0 e  0 

Cx:Cy  <=> _ :Vowel* %>:* %{NA%}: ;        
     where Cx in ( S1 ) 
           Cy in (  0 )
     matched ;


"Nõrgas astmes k p t -> g b d"
! lexical: v a a T1 i {NA}         
! surface: v a a  d i  0 

Cx:Cy  <=> _ :Vowel* %>:* %{NA%}: ;         
     where Cx in ( K1 P1 T1 ) 
           Cy in (  g  b  d )
     matched ;

"Nõrgas astmes kk pp tt -> k p t"
! lexical: k a p p {NA}          
! surface: k a p 0   0 

Cx:0  <=> :Cx _ %>:* :Vowel* %>:* %{NA%}: ;         
     where Cx in ( k p t ) ;


"Helitu hääliku järel gi > ki"
! lexical: kapp>gi
! surface: kapp>ki

g:k  <=>  :Voiceless %>:* _ :i .#.;

"Mitte-nimetavas ne -> se"
! lexical: s i n i N1 e >
! surface: s i n i  s e >

Cx:Cy <=> _ e: %>: ;
     where Cx in ( N1 ) 
           Cy in (  s )
     matched ;


! ----- täishäälikud


"Üksik kõrge vokaal madaldub, kui pärast nõrga sulghääliku kadumist jääb tema kõrvale vokaal"
! lexical: s u G1 u {NA}
! surface: s o  0 o  0 

Vx:Vy  <=>  [.#. | Consonant] :Vowel S1:0    _  %>:* %{NA%}: ;
            [.#. | Consonant]    _   S1:0 :Vowel %>:* %{NA%}: ;
       where Vx in ( u i ü )
             Vy in ( o e ö )
       matched;
       
"N1-e ja t vahel e kadu"
! lexical: s i n i N1 e > t
! surface: s i n i  s 0 > t

e:0 <=> N1: _ %>: t: ;
       
! ----- ti > si muutuse tagajärjed


"Enne t-d (S1)i > 0 " ! i muutmine
! lexical: k ä S1 i > t e
! surface: k ä  0 0 > t e

i:0  <=> [.#. | Consonant] :Vowel :0 _ %>:* :t ;

"Enne t-d S1(i) > 0 " ! S1 muutmine
! lexical: k ä S1 i > t e
! surface: k ä  0 0 > t e

Cx:Cy  <=> [.#. | Consonant] :Vowel _ i: %>:* :t ;       
     where Cx in ( S1 ) 
 	   Cy in ( 0 ) 
     matched;

