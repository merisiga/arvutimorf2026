Multichar_Symbols

+N  ! nimisõna				/ substantive		
+A  ! omadussõna			/ adjective		

+Sg  ! ainsus				/ singular
+Pl  ! mitmus				/ plural
+Nom  ! nimetav				/ nominative	
+Gen  ! omastav 			/ genitive	
+Par  ! osastav				/ partitive	
+Ill  ! sisseütlev			/ illative	
+Ine  ! seesütlev			/ inessive	
+Ela  ! seestütlev			/ elative	
+All  ! alaleütlev			/ allative	
+Ade  ! alalütlev			/ adessive	
+Abl  ! alaltütlev			/ ablative	
+Tra  ! saav				/ translative	
+Trm  ! rajav				/ terminative	
+Ess  ! olev				/ essive	
+Abe  ! ilmaütlev			/ abessive	
+Com  ! kaasaütlev			/ comitative	


%>                ! morfeemi piir
%{NA%}            ! nõrk aste

G1		! g või null
B1		! b või null
D1		! d või null
P1		! p või null
T1		! t või null
K1		! k või null
K2		! k või g
P2		! p või b
T2		! t või d



LEXICON Root

koli+N:koli tüüp_ema ;    ! leksikaalne pool : pindesitus
kena+A:kena tüüp_ema ;    ! pl par keni on puudu
siil+N:siil tüüp_taud ;    
pott+N:pott tüüp_taud ;    
sugu+N:suG1u tüüp_ema ;
vidin+N:vidin tüüp_vidin ;
redel+N:redel tüüp_redel ;
torssis+A:torssis # ;

! omad sõnad:
Dmitrii+N:Dmitrii tüüp_aasta ;
Filkin+N:Filkin tüüp_redel ;
Vahtra+N:Vaher tüüp_armas ; 
Valga+N:Valga tüüp_aasta  ;

! Astmevaheldus kk pp tt -> k p t 
pukk+N:puK1k tüüp_kk ;	!pukk-puki
papp+N:paP1p tüüp_pp ; !papp-papi
matt+N:maT1t tüüp_tt ; !matt-mati

! Astmevaheldus k p t -> g b d 
kook+N:kooK2 tüüp_k2 ; !kook-koogi
kaup+N:kauP2 tüüp_p2 ; !kaup-kauba
sõit+N:sõiT2 tüüp_t2 ; !sõit-sõidu

! gbd kaob
luba+N:luB1a tüüp_kpt ;		!luba-loa
tuba+N:tuB1a tüüp_kpt ;		!tuba-toa
rida+N:riD1a tüüp_kpt ; 	!rida-rea

LEXICON tüüp_ema
  +Sg+Nom: # ;
         :%{NA%} sg_gen_jt ; 
  +Sg+Par:%> # ;              
      +Pl:%>de gen_jt ;
  +Pl+Par:%>sid # ;
    
LEXICON tüüp_taud
    +Sg+Nom: # ;
           :%{NA%}%>i sg_gen_jt ;
    +Sg+Par:%>i # ;
    +Sg+Ill:%>i # ;      ! lühike sisseütlev
        +Pl:%>i%>de gen_jt ;
    +Pl+Par:%>e # ;

LEXICON tüüp_vidin
  +Sg+Nom: # ;
         :a 2C; 

LEXICON tüüp_redel
  +Sg+Nom: # ;
         :%>i 2C; 

LEXICON 2C
         : sg_gen_jt ; 
  +Sg+Par:%>t # ;
      +Pl:%>te gen_jt ;
  +Pl+Par:%>id # ;


LEXICON sg_gen_jt

      +Sg:%> gen_jt ;
  +Pl+Nom:%>d # ;
  
LEXICON gen_jt
       +Gen: # ;
       +Ill:sse # ;	
       +Ine:s # ;	
       +Ela:st # ;	
       +All:le # ;	
       +Ade:l # ;	
       +Abl:lt # ;	
       +Tra:ks # ;	
       +Trm:ni # ;	
       +Ess:na # ;	
       +Abe:ta # ;	
       +Com:ga # ;	













		   
