Definitions

Rules 

! ----- kaashäälikute astmevaheldus

"Nõrgas astmes vahel s kaob"
! lexical: k ä S1 i {NA}         
! surface: k ä  0 e  0 

Cx:Cy  <=> _ %>:* :Vowel* %>:* %{NA%}: :Vowel* ;        
     where Cx in ( S1 ) 
           Cy in (  0 )
     matched ;


"Nõrgas astmes k p t -> g b d"
! lexical: v a a T1 e {NA}         
! surface: v a a  d e  0 

Cx:Cy  <=> _ :Vowel* %{NA%}: ;         
     where Cx in ( K1 P1 T1 ) 
           Cy in (  g  b  d )
     matched ;

"Nõrgas astmes kk pp tt -> k p t"
! lexical: k a p p {NA}          
! surface: k a p 0   0 

Cx:0  <=> :Cx _ %>:* :Vowel* %>:* %{NA%}: ;         
     where Cx in ( k p t ) ;


"Helitu hääliku järel gi > ki"
! lexical: kapp>gi
! surface: kapp>ki

g:k  <=>  :Voiceless %>: _ :i .#.;



"Üksik kõrge vokaal madaldub, kui pärast nõrga sulghääliku kadumist jääb tema kõrvale vokaal"
! lexical: s u G1 u {NA}
! surface: s o  0 o  0 

Vx:Vy  <=>  [.#. | Consonant] :Vowel S1:0    _   ;
            [.#. | Consonant]    _   S1:0 :Vowel ;
       where Vx in ( u i ü )
             Vy in ( o e ö )
       matched;


" Enne t-d e > 0 " ! tahtsin teha S1 i > 0 0, aga ei osanud ega saand sellega ka hakkama
! S1 i > 0 0 oleks parem ka süsi:sütt jaoks
! lexical: k ä S1 i {NA} t e
! surface: k ä  0 0  0 te

Vx:Vy  <=> [.#. | Consonant] :Vowel S1:0 _ %>:* %{NA%}:* %>:* :t* ;       
     where Vx in ( e ) 
 	   Vy in ( 0 ) 
     matched;


