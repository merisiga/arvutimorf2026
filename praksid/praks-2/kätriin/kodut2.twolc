Definitions

Rules 
 

! ----- kaashäälikute astmevaheldus

"Nõrgas astmes vahel gbd kaob"

Cx:Cy  <=> _ :Vowel* %{NA%}: ;         ! võib-olla võiks kontekst olla ka: <=> _ %>:* :Vowel* %>:* %{NA%}: :Vowel*
     where Cx in ( G1 B1 D1 S1) 
           Cy in (  0  0  0  0)
     matched ;

! lexical: s u G1 u {NA}          NB! sellised kommentaarid tuleb kirjutada alati ENNE oma reegli kirjutamist; 
! surface: s o  0 o  0  

"Üksik kõrge vokaal madaldub, kui pärast nõrga sulghääliku kadumist jääb tema kõrvale vokaal"

Vx:Vy  <=>  [.#. | Consonant] :Vowel G1:0    _   ;
            [.#. | Consonant]    _   G1:0 :Vowel ;
       where Vx in ( u )
             Vy in ( o )
       matched;

! lexical: s u G1 u {NA}
! surface: s o  0 o  0  

"kui i-le järgneb i-ga algav lõpp, siis ta madaldub e-ks "

i:e  <=>  :Consonant %>:* _ %>: :i ;
      
! lexical: r e d e l i > i d
! surface: r e d e l e > i d

"kk pp tt -> k p t"

Cx:0  <=> :Cx _ %>:* :Vowel* %{NA%}: ;         ! võib-olla võiks kontekst olla ka: <=> _ %{NA%}: 
     where Cx in ( k p t ) ;

! lexical: p o t t {NA}          NB! sellised kommentaarid tuleb kirjutada alati ENNE oma reegli kirjutamist; 
! surface: p o t 0   0 

! ----- helitu hääliku puhul gi muudetakse ki-ks
"Helitu hääliku (g b d k p t s š h f) puhul ki"

G2:k <=> Voiceless _ :i ;

! lexical: t a s s g i
! surface: t a s s k i

"k p t -> g b d"
Cx:Cy  <=> Vowel* _ %{NA%}: ;
     where Cx in ( K1 P1 T1 )
           Cy in (  g  b  d )
           matched ;

! lexical: v a a t i
! surface: v a a d i
